// Cloudflare Workers settings: serve the built blog in ./site as a static site.
{
  "name": "jtmaui-blog",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "blog.jtmaui.com", "custom_domain": true }
  ]
}
